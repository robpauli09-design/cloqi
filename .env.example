# Lokale Vorlage: als .env kopieren und Werte dort ergänzen.
# Der Entwicklungsserver lädt .env. Nach Änderungen neu starten.

# Nur Server: niemals mit VITE_ präfixieren oder in Browsercode verwenden.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Public demo AI: explicit opt-in, shared Supabase limit 3/minute and 50/day.
DEMO_AI_ENABLED=false

# Öffentlich: aus dem Supabase-Connect-Dialog übernehmen.
# Nur den Publishable Key verwenden; kein Secret-/service_role-Schlüssel.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Server-Aliase. Leer = obige VITE_SUPABASE_*-Werte verwenden.
# Wenn gesetzt, müssen URL und Key zum selben Projekt wie das Frontend gehören.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: zusätzliche erlaubte Ursprünge (Kommaliste, ohne Pfad).
# Anfragen vom eigenen Ursprung sind automatisch erlaubt.
# Beispiel: https://app.example.com,http://localhost:5173
ALLOWED_ORIGINS=

# Optional für getrennte/spätere Clients: Backend-Ursprung ohne /api.
# Beispiel: https://cloqi.example.com
# Im gemeinsamen Vercel-Projekt und lokal leer lassen.
VITE_API_BASE_URL=
