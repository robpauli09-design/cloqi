# Öffentliche Adresse der App (für OAuth-Redirects und Kalender-Feeds)
APP_URL=http://localhost:3000

# 32 Byte Schlüssel (base64) zum Verschlüsseln von Tokens und Feed-Links.
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In der Entwicklung wird automatisch einer unter .data/ erzeugt; in Produktion Pflicht.
CLOQI_ENCRYPTION_KEY=

# Speicherort der SQLite-Datenbank (Standard: .data/cloqi.db)
# DATABASE_PATH=.data/cloqi.db

# Zeitzone für neue Konten
DEFAULT_TIMEZONE=Europe/Vienna

# Google Kalender (Google Cloud Console → OAuth-Client "Webanwendung")
# Redirect-URI: {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Outlook (Azure Portal → App-Registrierung)
# Redirect-URI: {APP_URL}/api/integrations/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Schützt /api/cron/sync (regelmäßige Synchronisierung, z. B. alle 30 Minuten aufrufen)
CRON_SECRET=
