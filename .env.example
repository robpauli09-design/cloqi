# ─── Pflicht ───────────────────────────────────────────────────────────────

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (Port 6543)
# Beispiel: postgresql://postgres.<projekt-id>:<DB-PASSWORT>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 32 Byte Zufallsschlüssel (base64) – verschlüsselt OAuth-Tokens, WebUntis-Link, Feed-Link, Zyklusdaten.
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NIE ändern, sobald echte Daten existieren (sonst sind verschlüsselte Daten nicht mehr lesbar).
CLOQI_ENCRYPTION_KEY=

# Öffentliche Adresse der App (für OAuth-Redirects und Kalender-Feed-Links), ohne / am Ende
APP_URL=http://localhost:3000

# ─── CLOQI AI (Sprachmodell, OpenAI-kompatible Schnittstelle) ─────────────

AI_API_KEY=
AI_MODEL=
# Standard: https://api.openai.com/v1 – für EU-Hosting z. B. die Basis-URL deines EU-Anbieters
# AI_BASE_URL=

# ─── Optional ──────────────────────────────────────────────────────────────

# Zeitzone für neue Konten
DEFAULT_TIMEZONE=Europe/Vienna

# Schützt /api/cron/sync (Vercel Cron schickt ihn automatisch mit)
CRON_SECRET=

# Google Kalender (Google Cloud Console → OAuth-Client "Webanwendung")
# Redirect-URI: {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Outlook (Azure Portal → App-Registrierung)
# Redirect-URI: {APP_URL}/api/integrations/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
