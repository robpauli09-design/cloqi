{
  "expo": {
    "name": "CLOQI",
    "slug": "cloqi",
    "scheme": "cloqi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cloqi.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.cloqi.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F2"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "CLOQI braucht das Mikrofon, damit du Termine und Tests einfach einsprechen kannst."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CLOQI braucht Zugriff auf deine Fotos, damit du z. B. einen Stundenplan oder Testinfos schicken kannst.",
          "cameraPermission": "CLOQI braucht die Kamera, damit du z. B. die Tafel oder einen Zettel fotografieren kannst.",
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
